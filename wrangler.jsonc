{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "real8ball",
  "main": "server/worker.ts",
  "account_id": "8849b122bf64a29c4705a85dbbd2d9b3",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "real8ball.com", "custom_domain": true },
    { "pattern": "www.real8ball.com", "custom_domain": true }
  ],
  "ratelimits": [{ "name": "ORACLE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }],
  "observability": { "enabled": true }
}
